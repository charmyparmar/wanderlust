<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-12">
    <!-- Back Link -->
    <a href="/profile" class="text-muted text-decoration-none mb-3 d-inline-block transition-all hover-link" style="font-size: 0.95rem;">
      <i class="fa-solid fa-arrow-left me-1"></i> Back to Profile
    </a>

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
      <div>
        <h2 class="fw-bold text-dark mb-1">
          <i class="fa-solid fa-hotel me-2 text-primary"></i>My Listed Properties
        </h2>
        <p class="text-muted mb-0">Manage the properties you have published on WanderLust</p>
      </div>
      <div class="d-flex align-items-center gap-3 mt-3 mt-md-0">
        <span class="badge bg-primary fs-6 py-2 px-3 rounded-pill"><%= myListings.length %> Properties</span>
        <a href="/listings/new" class="btn btn-dark edit-btn px-4 py-2 border-0 text-white rounded-3 shadow-sm">
          <i class="fa-solid fa-plus me-2"></i>Add New Stay
        </a>
      </div>
    </div>

    <!-- Listings Grid -->
    <% if (myListings.length === 0) { %>
      <div class="card shadow border border-light-subtle rounded-4 p-5 bg-white text-center my-4">
        <div class="text-muted fs-1 mb-3"><i class="fa-solid fa-house-chimney-user"></i></div>
        <h4 class="fw-bold text-dark">No properties listed yet</h4>
        <p class="text-muted small mx-auto" style="max-width: 480px;">Ready to host? List your beautiful apartments, resorts, or cozy cabins today and let explorers find them easily!</p>
        <a href="/listings/new" class="btn btn-dark edit-btn px-4 py-2 mt-3 border-0 text-white rounded-3">
          <i class="fa-solid fa-circle-plus me-2"></i>List Your Property
        </a>
      </div>
    <% } else { %>
      <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-md-3">
        <% for (let listing of myListings) { %>
          <div class="col">
            <div class="card h-100 border border-light-subtle bg-white p-3 rounded-4 shadow-sm transition-all hover-scale position-relative">
              
              <!-- Image -->
              <div class="position-relative overflow-hidden rounded-3 mb-3" style="height: 180px;">
                <img 
                  src="<%= listing.image %>" 
                  class="w-100 h-100 object-fit-cover transition-all" 
                  alt="<%= listing.title %>"
                />
              </div>

              <!-- Content -->
              <div class="card-body p-0 d-flex flex-column h-100">
                <h5 class="fw-bold text-dark text-truncate mb-1"><%= listing.title %></h5>
                <p class="text-muted small mb-3"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></p>
                
                <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                  <span class="fw-bold text-primary">&#8377; <%= listing.price.toLocaleString('en-IN') %> <small class="text-muted fw-normal">/ night</small></span>
                  
                  <!-- Action Buttons -->
                  <div class="d-flex gap-2">
                    <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="View Details">
                      <i class="fa-solid fa-eye" style="font-size: 0.85rem;"></i>
                    </a>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Edit Stay">
                      <i class="fa-solid fa-pen" style="font-size: 0.85rem;"></i>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>

  </div>
</div>

<style>
  .hover-scale {
    transition: var(--transition);
  }
  .hover-scale:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover) !important;
  }
  .hover-link:hover {
    color: var(--primary) !important;
  }
</style>
