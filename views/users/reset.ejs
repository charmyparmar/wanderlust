<% layout("/layouts/boilerplate") %>

<div class="row mt-5 justify-content-center">
  <div class="col-11 col-sm-10 col-md-6 col-lg-4">
    <div class="card shadow-sm border border-light-subtle rounded-4 p-4 bg-white">
      <div class="text-center mb-4">
        <i class="fa-solid fa-lock-open mb-3" style="font-size: 3rem; color: var(--primary);"></i>
        <h2 class="fw-bold text-dark">Reset Password</h2>
        <p class="text-muted">Enter a new secure password below</p>
      </div>

      <form action="/reset-password" method="POST" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">
        
        <!-- Password -->
        <div class="mb-3">
          <label for="password" class="form-label fw-semibold">New Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-grey rounded-start-3"><i class="fa-solid fa-lock text-secondary"></i></span>
            <input
              type="password"
              name="password"
              id="password"
              class="form-control border-grey rounded-end-3"
              placeholder="••••••••"
              required
            />
            <div class="invalid-feedback">Please enter a new password.</div>
          </div>
        </div>

        <!-- Confirm Password -->
        <div class="mb-4">
          <label for="confirmPassword" class="form-label fw-semibold">Confirm Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-grey rounded-start-3"><i class="fa-solid fa-lock text-secondary"></i></span>
            <input
              type="password"
              name="confirmPassword"
              id="confirmPassword"
              class="form-control border-grey rounded-end-3"
              placeholder="••••••••"
              required
            />
            <div class="invalid-feedback">Please confirm your new password.</div>
          </div>
        </div>

        <!-- Submit Button -->
        <button class="btn btn-dark w-100 py-2.5 fw-semibold rounded-3 edit-btn border-0 text-white transition-all">
          <i class="fa-solid fa-circle-check me-2"></i>Update Password
        </button>
      </form>
    </div>
  </div>
</div>
