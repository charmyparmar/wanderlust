<!-- Index show all listing -->


<% layout("/layouts/boilerplate") %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3 g-4">
  <% for (let listing of allListings) { %>
    <div class="col">
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card h-100 border-0">
          <img 
            src="<%= listing.image%>" 
            class="card-img-top" 
            alt="<%= listing.title %>"
          />
          <div class="card-body">
            <p class="card-text">
              <b class="d-block text-dark"><%= listing.title %></b>
              <% if (listing && listing.price) { %>
                <span class="text-secondary fw-500">&#8377;<%= listing.price.toLocaleString('en-IN') %> / night</span>
              <% } else { %>
                <span class="text-muted">Price not available</span>
              <% } %>
            </p>
          </div>
        </div>
      </a>
    </div>
  <% } %>
</div>
